<?xml version="1.0"?>
<package format="2">
  <name>robocar_apriltag_nav</name>
  <version>1.0.0</version>
  <description>
    ROS1 package for navigating the RoboCar to designated areas identified
    by AprilTags.  Combines camera-based tag detection with a PD controller
    that sends velocity commands to the STM32 chassis over a serial link.
  </description>

  <maintainer email="user@example.com">RoboCar Developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- AprilTag detection -->
  <depend>apriltag_ros</depend>

  <!-- Camera driver (usb_cam or equivalent) -->
  <exec_depend>usb_cam</exec_depend>

  <export></export>
</package>
